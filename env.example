# Database
DATABASE_URL="postgresql://user:password@localhost:5432/garden_db?schema=public"

# Auth0 Configuration (v4 SDK)
# Générez un secret avec: openssl rand -hex 32
AUTH0_SECRET="use-openssl-rand-hex-32-to-generate-this"
APP_BASE_URL="http://localhost:3000"
AUTH0_DOMAIN="https://dev-1tkaqeynik4yy714.us.auth0.com"
AUTH0_CLIENT_ID="Lt54JQ2uYcmyTU0oo7Tu5EVwJJIIBJX9"
AUTH0_CLIENT_SECRET="your-auth0-client-secret-here"
# Si votre application est API autorisée, ajoutez ces variables:
# AUTH0_AUDIENCE="your_auth_api_identifier"
# AUTH0_SCOPE="openid profile email read:shows"

# Auth0 Management API (pour assigner les rôles)
# Créez une application Machine to Machine dans Auth0 et utilisez ces identifiants
AUTH0_M2M_CLIENT_ID="votre_client_id_m2m"
AUTH0_M2M_CLIENT_SECRET="votre_client_secret_m2m"
AUTH0_M2M_AUDIENCE="https://votre-tenant.auth0.com/api/v2/"
# ID du rôle par défaut à assigner (commence par rol_)
# Trouvez-le dans Auth0 > User Management > Roles > [Votre rôle]
AUTH0_DEFAULT_ROLE_ID="rol_xxxxxxxxxxxxx"

# NextAuth
NEXTAUTH_URL="http://localhost:3002"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# JWT Secret for custom auth
JWT_SECRET="your-jwt-secret-here"

# Stripe
STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
STRIPE_PORTAL_RETURN_URL="http://localhost:3000/profile"
STRIPE_ENABLE_PAYPAL="false"
NEXT_PUBLIC_STRIPE_ENABLE_PAYPAL="false"

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Webhook secret utilisé par l'Action Auth0 (post-registration) pour injecter l'utilisateur
AUTH0_ACTION_WEBHOOK_SECRET="your-auth0-action-webhook-secret"

# SendGrid Email
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="contact@gardengoldgreen.com"

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Chat Support (Crisp)
NEXT_PUBLIC_CRISP_WEBSITE_ID="your-crisp-website-id"

# Admin dashboard bypass (à mettre à "false" pour réactiver la sécurité)
NEXT_PUBLIC_FORCE_ADMIN_BYPASS="true"
BYPASS_ADMIN_SECURITY="true"
